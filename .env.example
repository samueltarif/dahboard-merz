# Copie para .env e preencha. O .env NUNCA vai para o Git (está no .gitignore).

# === Opção A (recomendada agora): Supabase pela API REST ======================
# Painel do Supabase > Settings > API Keys. Use a chave de SERVIDOR (service_role ou sb_secret_...).
# Antes do 1º uso, rode supabase/migrations/0001_init.sql no SQL Editor do projeto.
SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Ainda não usadas (reservadas para quando houver login):
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=

# === Opção B: conexão direta ao banco (Postgres) ==============================
# Se DATABASE_URL estiver preenchida, ela tem prioridade sobre a Opção A.
# Local sem nada instalado (padrão quando nada está configurado): sqlite:///data/dashboard.db
# Postgres do docker-compose:   postgresql://painel:painel@localhost:5432/painel
# Supabase (Connect > Session pooler): postgresql://postgres.SEU_PROJETO:SENHA@aws-0-us-east-1.pooler.supabase.com:5432/postgres
# DATABASE_URL=

# Força um backend: auto | supabase | sql
STORAGE_BACKEND=auto

EMPRESA_LABEL=Filial SP
HOST=127.0.0.1
PORT=8000
MAX_UPLOAD_MB=80
